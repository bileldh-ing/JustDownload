# ---- shared secrets (generate: openssl rand -base64 36) -------------------
# Web app -> worker API bearer token (>= 24 chars). Set the SAME value on web and worker.
WORKER_API_TOKEN=change-me-to-a-long-random-token
# Worker-only: HMAC key for signed download/upload/event URLs (>= 32 chars).
SIGNING_SECRET=change-me-to-a-different-long-random-secret

# ---- worker ----------------------------------------------------------------
# Public base URL browsers use to reach the worker (signed downloads, uploads, SSE).
WORKER_PUBLIC_URL=http://localhost:8080
# Origin of the web app, for the worker's CORS allow-list (comma-separated).
WEB_ORIGIN=http://localhost:3000
RETENTION_MINUTES=60
MAX_SOURCE_MB=1024
MAX_UPLOAD_MB=512
MAX_DURATION_MIN=180
CONCURRENCY_VIDEO=1
CONCURRENCY_AUDIO=2
# Server-side provider policy overrides (JSON). Leave empty unless a use is confirmed permitted.
JD_PROVIDER_POLICY_OVERRIDES=
# TEST ONLY: allows loopback/private destinations. Refused when NODE_ENV=production.
JD_ALLOW_PRIVATE_NETWORK=

# ---- web -------------------------------------------------------------------
# Leave WORKER_URL empty to run in inspection-only mode (e.g. on Vercel without a worker).
WORKER_URL=
# Build-time: added to the CSP connect-src so the browser may upload to / stream events from the worker.
NEXT_PUBLIC_WORKER_PUBLIC_URL=
# Optional contact shown on the privacy page; otherwise reports go to GitHub issues.
NEXT_PUBLIC_CONTACT_EMAIL=
COOKIE_SECURE=
