{
  "name": "@justdownload/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JustDownload media worker: inspection API, BullMQ job processing with FFprobe/FFmpeg, signed artifact delivery.",
  "scripts": {
    "dev": "tsx watch src/main.ts all",
    "start": "node dist/main.js",
    "build": "node build.mjs",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@justdownload/core": "workspace:*",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "ipaddr.js": "2.5.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
